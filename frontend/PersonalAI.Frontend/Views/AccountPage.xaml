<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalAI.Frontend.Views.AccountPage"
             Title="Account">
    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
        <Label x:Name="EmailLabel" FontSize="18" HorizontalOptions="Center" />
        <Label x:Name="DisplayNameLabel" FontSize="16" HorizontalOptions="Center" />
        <Button Text="Log Out" Clicked="OnLogoutClicked" />
    </VerticalStackLayout>
</ContentPage>