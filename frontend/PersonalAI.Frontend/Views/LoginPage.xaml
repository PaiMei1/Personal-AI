<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalAI.Frontend.Views.LoginPage"
             Title="Log In">
    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
        <Label Text="Personal AI" FontSize="28" HorizontalOptions="Center" />

        <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />
        <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />

        <Button Text="Log In" Clicked="OnLoginClicked" />
        <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" />

        <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" />
        <Button Text="Don't have an account? Sign up" Clicked="OnSignupNavigateClicked" BackgroundColor="Transparent" TextColor="Blue" />
    </VerticalStackLayout>
</ContentPage>