<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PersonalAI.Frontend.Views.SignupPage"
             Title="Sign Up">
    <VerticalStackLayout Padding="30" Spacing="15" VerticalOptions="Center">
        <Label Text="Create Account" FontSize="28" HorizontalOptions="Center" />

        <Entry x:Name="DisplayNameEntry" Placeholder="Display Name" />
        <Entry x:Name="EmailEntry" Placeholder="Email" Keyboard="Email" />
        <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />

        <Button Text="Sign Up" Clicked="OnSignupClicked" />
        <Label x:Name="ErrorLabel" TextColor="Red" IsVisible="False" />

        <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" />
    </VerticalStackLayout>
</ContentPage>